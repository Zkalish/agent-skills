//@version=6
// ============================================================
// PHL2 YIGITBOX - En Iyi Filtre Kombinasyonu
// HHV + ST + Vortex = 2.043 PF
// ============================================================

strategy(
     "PHL2 YIGITBOX Best",
     overlay     = true,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     commission_type = strategy.commission.percent,
     commission_value = 0,
     slippage = 1
)

// ============================================================
// GIRDILER
// ============================================================

wprLength = input.int(3, title="Williams %R", minval=2)
longWpr = input.float(-20, title="LONG WillR")
shortWpr = input.float(-70, title="SHORT WillR")

showPlots = input.bool(true, title="Goster")

// ============================================================
// ============================================================
// TREND MA Filtresi (SMA, EMA, VAR, ZLMA, DEMA) - MTF
// ============================================================

useTrend = input.bool(false, title="Trend MA?", group="Filtreler")
trendTimeframe = input.timeframe(title="Timeframe", defval="1D", group="Filtreler")
trendType = input.string("SMA", title="MA Tipi", options=["SMA","EMA","VAR","ZLMA","DEMA"], group="Filtreler")
trendPeriod = input.int(21, title="MA Period", group="Filtreler")

// MTF veri
dTrend = request.security(syminfo.tickerid, trendTimeframe, close, lookahead=barmerge.lookahead_off)

trendMA = switch trendType
    "SMA" => ta.sma(dTrend, trendPeriod)
    "EMA" => ta.ema(dTrend, trendPeriod)
    "VAR" => ta.variance(dTrend, trendPeriod)
    "ZLMA" => ta.ema(ta.ema(dTrend, math.round(trendPeriod/2)), math.round(trendPeriod/2))
    "DEMA" => 2 * ta.ema(dTrend, trendPeriod) - ta.ema(ta.ema(dTrend, trendPeriod), trendPeriod)
    => ta.ema(dTrend, trendPeriod)

// ============================================================
// MOST Filtresi (3, 2 - Orijinal) - MTF
// ============================================================

useMOST = input.bool(false, title="MOST?", group="Filtreler")
mostTimeframe = input.timeframe(title="Timeframe", defval="1D", group="Filtreler")
mostPeriod = input.int(3, title="MOST Period", group="Filtreler")
mostPercent = input.float(2.0, title="MOST %", group="Filtreler")

// MTF veri
dMostMA = request.security(syminfo.tickerid, mostTimeframe, close, lookahead=barmerge.lookahead_off)
dMostHigh = request.security(syminfo.tickerid, mostTimeframe, high, lookahead=barmerge.lookahead_off)
dMostLow = request.security(syminfo.tickerid, mostTimeframe, low, lookahead=barmerge.lookahead_off)

// MOST hesaplama
mostMA = ta.ema(dMostMA, mostPeriod)
mostStopLong = mostMA * (1 - mostPercent / 100)
mostStopShort = mostMA * (1 + mostPercent / 100)

MOSTLong = math.max(dMostLow, mostStopLong)
MOSTShort = math.min(dMostHigh, mostStopShort)

// ============================================================
// Filtreler - Aktif/Pasif
useHHV = input.bool(true, title="HHV/LLV?", group="Filtreler")
useST = input.bool(true, title="SuperTrend?", group="Filtreler")
useVortex = input.bool(true, title="Vortex?", group="Filtreler")
useMJR = input.bool(false, title="MJR?", group="Filtreler")

stPeriod = input.int(2, title="ST Period", group="Filtreler")
stMult = input.float(2, title="ST Multiplier", group="Filtreler")

// ============================================================
// SUPERTREND
// ============================================================

srcST = (high + low) / 2
atrST = ta.atr(stPeriod)

upLine = srcST + (stMult * atrST)
downLine = srcST - (stMult * atrST)

var int trendST = 1
trendST := close > nz(upLine[1], upLine) ? 1 : close < nz(downLine[1], downLine) ? -1 : nz(trendST[1], 1)

stValue = trendST == 1 ? downLine : upLine

// ============================================================
// VORTEX
// ============================================================

periodVX = 6

tr = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
vmPlus = math.abs(high - low[1])
vmMinus = math.abs(low - high[1])

PVTX = ta.sma(vmPlus, periodVX) / ta.sma(tr, periodVX)
NVTX = ta.sma(vmMinus, periodVX) / ta.sma(tr, periodVX)

// ============================================================
// MJR - Majority Rule (Yumusatilmis Stochastic)
// ============================================================

mjrPeriod = input.int(9, title="MJR Period", group="Filtreler")
mjrSmooth = input.int(3, title="MJR Smooth", group="Filtreler")

// Stochastic + SMA (yumuşatılmış)
MJR = ta.sma(ta.stoch(close, high, low, mjrPeriod), mjrSmooth)

// ============================================================
// GUNLUK VERI
// ============================================================

[dHigh, dLow, dClose, dTime] = request.security(
     syminfo.tickerid, "D",
     [high, low, close, time],
     lookahead = barmerge.lookahead_on
)

isNewDay = ta.change(dTime) != 0

// ============================================================
// DEGERLER
// ============================================================

var float ADAM = na
var float TX_val = na
var float RX_val = na

if isNewDay
    ADAM := dClose[1]
    TX_val := math.max(dHigh[1], high)
    RX_val := math.min(dLow[1], low)
else
    TX_val := math.max(TX_val, high)
    RX_val := math.min(RX_val, low)

PVT1 = (ADAM + RX_val + TX_val) / 3
PVT2 = ADAM

sma1 = ta.sma(close, 1)
wpr = ta.wpr(wprLength)

// ============================================================
// FILTRE FONKSIYONLARI
// ============================================================

filterHHVLong(x) => not useHHV or (x > ta.highest(high, 3)[1])
filterSTLong(x) => not useST or (x > stValue)
filterVortexLong(x) => not useVortex or (PVTX > NVTX)

// Trend MA Filtresi (MTF)
filterTrendLong(x) => not useTrend or (x > trendMA)
filterTrendShort(x) => not useTrend or (x < trendMA)

// MOST Filtresi (MTF, 3, 2)
filterMOSTLong(x) => not useMOST or (close > MOSTLong)
filterMOSTShort(x) => not useMOST or (close < MOSTShort)

filterHHVShort(x) => not useHHV or (x < ta.lowest(low, 3)[1])
filterSTShort(x) => not useST or (x < stValue)
filterVortexShort(x) => not useVortex or (NVTX > PVTX)

// MJR Filtresi - Stochastic için
mjrLongThreshold = input.float(75, title="MJR LONG", group="Filtreler")  // Stochastic > 75
mjrShortThreshold = input.float(25, title="MJR SHORT", group="Filtreler") // Stochastic < 25

filterMJRLong(x) => not useMJR or (MJR > mjrLongThreshold)
filterMJRShort(x) => not useMJR or (MJR < mjrShortThreshold)

// ============================================================
// SINYALLER
// ============================================================

longCond =
     (sma1 > PVT2) and (sma1 > PVT1) and (wpr > longWpr) and
     filterTrendLong(close) and
     filterHHVLong(high) and
     filterSTLong(close) and
     filterVortexLong(close) and
     filterMOSTLong(close)

shortCond =
     (sma1 < PVT2) and (sma1 < PVT1) and (wpr < shortWpr) and
     filterTrendShort(close) and
     filterHHVShort(low) and
     filterSTShort(close) and
     filterVortexShort(close) and
     filterMOSTShort(close)

longEntry = longCond and not longCond[1]
shortEntry = shortCond and not shortCond[1]

inLong = strategy.position_size > 0
inShort = strategy.position_size < 0
noPos = strategy.position_size == 0

// ============================================================
// ISLEMLER
// ============================================================

if noPos and longEntry
    strategy.entry("Long", strategy.long)

if noPos and shortEntry
    strategy.entry("Short", strategy.short)

if inLong and shortEntry
    strategy.close("Long")
    strategy.entry("Short", strategy.short)

if inShort and longEntry
    strategy.close("Short")
    strategy.entry("Long", strategy.long)

// ============================================================
// GORSEL
// ============================================================

plot(showPlots ? PVT1 : na, "PVT1", color.blue, 2)
plot(showPlots ? PVT2 : na, "PVT2", color.orange, 2)
plot(showPlots and useST ? stValue : na, "SuperTrend", color.purple, 2)

plotshape(noPos and longEntry, title="BUY", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.tiny)
plotshape(noPos and shortEntry, title="SELL", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.tiny)
plotshape(inLong and shortEntry, title="SELL", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.tiny)
plotshape(inShort and longEntry, title="BUY", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.tiny)

// Panel
var table info = table.new(position.bottom_right, 2, 8, bgcolor=color.black)

if barstate.islast
    table.cell(info, 0, 0, "PVT1:", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, str.tostring(PVT1, format.mintick), text_color=color.orange, text_size=size.small)
    table.cell(info, 0, 1, "PVT2:", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 1, str.tostring(PVT2, format.mintick), text_color=color.orange, text_size=size.small)
    table.cell(info, 0, 2, "ST:", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 2, str.tostring(stValue, format.mintick), text_color=color.purple, text_size=size.small)
    table.cell(info, 0, 3, "WillR:", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 3, str.tostring(wpr, format.mintick), text_color=color.orange, text_size=size.small)
    table.cell(info, 0, 4, "HHV3:", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 4, str.tostring(ta.highest(high, 3)[1], format.mintick), text_color=color.orange, text_size=size.small)
    table.cell(info, 0, 5, "VORTEX:", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 5, str.tostring(PVTX - NVTX, format.mintick), text_color=color.orange, text_size=size.small)
    table.cell(info, 0, 6, "MJR:", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 6, str.tostring(MJR, format.mintick), text_color=color.orange, text_size=size.small)
