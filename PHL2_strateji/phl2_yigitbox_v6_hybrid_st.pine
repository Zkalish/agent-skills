//@version=6
// ============================================================
// PHL2 YIGITBOX - Hybrid + SuperTrend Filtresi
// ============================================================

strategy(
     "PHL2 YIGITBOX Hybrid + ST",
     overlay     = true,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     commission_type = strategy.commission.percent,
     commission_value = 0,
     slippage = 1
)

// ============================================================
// GIRDILER
// ============================================================

// Williams %R
wprLength = input.int(3, title="Williams %R", minval=2)
longWpr = input.float(-20, title="LONG WillR")
shortWpr = input.float(-70, title="SHORT WillR")

// SuperTrend - Standart SuperTrend
useST = input.bool(true, title="SuperTrend Filtre?")
stPeriod = input.int(14, title="ST Period", group="SuperTrend")  // 14 standart
stMult = input.float(3, title="ST Multiplier", group="SuperTrend")  // 3 standart

showPlots = input.bool(true, title="Göster")

// ============================================================
// FONKSIYONLAR
// ============================================================

GetHighestSince(cond, src) =>
    var float val = na
    if cond or src > val
        val := src
    val

GetLowestSince(cond, src) =>
    var float val = na
    if cond or src < val
        val := src
    val

// ============================================================
// SUPERTREND
// ============================================================

srcST = (high + low) / 2
atrST = ta.atr(stPeriod)

upLine = srcST + (stMult * atrST)
downLine = srcST - (stMult * atrST)

// Trend (klasik SuperTrend)
var int trendST = 1
trendST := close > nz(upLine[1], upLine) ? 1 : close < nz(downLine[1], downLine) ? -1 : nz(trendST[1], 1)

// ST değeri
stValue = trendST == 1 ? downLine : upLine

// ============================================================
// GÜNLÜK VERİ + GÜN İÇİ
// ============================================================

[dHigh, dLow, dClose, dTime] = request.security(
     syminfo.tickerid, "D",
     [high, low, close, time],
     lookahead = barmerge.lookahead_on
)

isNewDay = ta.change(dTime) != 0

// ============================================================
// DEĞERLER
// ============================================================

var float ADAM = na
var float TX_val = na
var float RX_val = na

if isNewDay
    ADAM := dClose[1]
    TX_val := math.max(dHigh[1], high)
    RX_val := math.min(dLow[1], low)
else
    TX_val := math.max(TX_val, high)
    RX_val := math.min(RX_val, low)

PVT1 = (ADAM + RX_val + TX_val) / 3
PVT2 = ADAM

sma1 = ta.sma(close, 1)
wpr = ta.wpr(wprLength)

// ============================================================
// FİLTRELER
// ============================================================

// SuperTrend Filtresi - Sadece fiyat pozisyonu + na kontrolü
stLongFilter = not useST or na(stValue) or (close > stValue)
stShortFilter = not useST or na(stValue) or (close < stValue)

// ============================================================
// SİNYALLER
// ============================================================

longCond = (sma1 > PVT2) and (sma1 > PVT1) and (wpr > longWpr) and stLongFilter
shortCond = (sma1 < PVT2) and (sma1 < PVT1) and (wpr < shortWpr) and stShortFilter

longEntry = longCond and not longCond[1]
shortEntry = shortCond and not shortCond[1]

inLong = strategy.position_size > 0
inShort = strategy.position_size < 0
noPos = strategy.position_size == 0

// ============================================================
// İŞLEMLER
// ============================================================

if noPos and longEntry
    strategy.entry("Long", strategy.long)

if noPos and shortEntry
    strategy.entry("Short", strategy.short)

if inLong and shortEntry
    strategy.close("Long")
    strategy.entry("Short", strategy.short)

if inShort and longEntry
    strategy.close("Short")
    strategy.entry("Long", strategy.long)

// ============================================================
// GÖRSEL
// ============================================================

plot(showPlots ? PVT1 : na, "PVT1", color.blue, 2)
plot(showPlots ? PVT2 : na, "PVT2", color.orange, 2)
plot(showPlots and useST ? stValue : na, "SuperTrend", color.purple, 2)

plotshape(noPos and longEntry, title="BUY", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.tiny)
plotshape(noPos and shortEntry, title="SELL", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.tiny)
plotshape(inLong and shortEntry, title="SELL", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.tiny)
plotshape(inShort and longEntry, title="BUY", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.tiny)

// Panel
var table info = table.new(position.bottom_right, 2, 5, bgcolor=color.black)

if barstate.islast
    table.cell(info, 0, 0, "PVT1:", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, str.tostring(PVT1, format.mintick), text_color=color.orange, text_size=size.small)
    table.cell(info, 0, 1, "PVT2:", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 1, str.tostring(PVT2, format.mintick), text_color=color.orange, text_size=size.small)
    table.cell(info, 0, 2, "ST:", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 2, str.tostring(stValue, format.mintick), text_color=color.purple, text_size=size.small)
    table.cell(info, 0, 3, "WillR:", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 3, str.tostring(wpr, format.mintick), text_color=color.orange, text_size=size.small)
    table.cell(info, 0, 4, "Trend:", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 4, trendST == 1 ? "YUKARI" : "ASAGI", text_color=trendST == 1 ? color.lime : color.red, text_size=size.small)
