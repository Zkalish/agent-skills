//@version=6
// ============================================================
// PHL2 YIGITBOX - Erol İndikatör Mantığı (Pivot)
// ============================================================

strategy(
     "PHL2 YIGITBOX Pivot",
     overlay     = true,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     commission_type = strategy.commission.percent,
     commission_value = 0,
     slippage = 1
)

// ============================================================
// GIRDILER
// ============================================================

wprLength = input.int(3, title="Williams %R", minval=2)
longWpr = input.float(-20, title="LONG WillR")
shortWpr = input.float(-70, title="SHORT WillR")
showPlots = input.bool(true, title="Göster")

// ============================================================
// GÜNLÜK VERİ
// ============================================================

[xHigh, xLow, xClose] = request.security(
     syminfo.tickerid, "D",
     [high, low, close],
     lookahead = barmerge.lookahead_off
)

// ============================================================
// DEĞERLER - Erol Formülü
// ============================================================

// Klasik Pivot (günlük)
vPP = (xHigh[1] + xLow[1] + xClose[1]) / 3
vPU = 2 * vPP - xLow[1]   // Üst direnç
vPA = 2 * vPP - xHigh[1]  // Alt destek

// İkinci seviye (önceki günün değerleri)
vPP2 = xClose[1]                       // Önceki günün kapanışı
vPU2 = vPP2 + (xHigh[1] - xLow[1]) / 2 // Üst bant
vPA2 = vPP2 - (xHigh[1] - xLow[1]) / 2 // Alt bant

// Kullanacağımız seviyeler
pvt1 = vPP   // Pivot ortalama
pvt2 = vPP2  // Önceki günün kapanışı

sma1 = ta.sma(close, 1)
wpr = ta.wpr(wprLength)

// ============================================================
// SİNYALLER
// ============================================================

// LONG: Fiyat hem pvt2 hem pvt1 üzerinde VE WillR > -20
longCond = (sma1 > pvt2) and (sma1 > pvt1) and (wpr > longWpr)

// SHORT: Fiyat hem pvt2 hem pvt1 altında VE WillR < -70
shortCond = (sma1 < pvt2) and (sma1 < pvt1) and (wpr < shortWpr)

// Sadece değişimde gir
longEntry = longCond and not longCond[1]
shortEntry = shortCond and not shortCond[1]

inLong = strategy.position_size > 0
inShort = strategy.position_size < 0
noPos = strategy.position_size == 0

// ============================================================
// İŞLEMLER
// ============================================================

if noPos and longEntry
    strategy.entry("Long", strategy.long)

if noPos and shortEntry
    strategy.entry("Short", strategy.short)

if inLong and shortEntry
    strategy.close("Long")
    strategy.entry("Short", strategy.short)

if inShort and longEntry
    strategy.close("Short")
    strategy.entry("Long", strategy.long)

// ============================================================
// GÖRSEL
// ============================================================

plot(showPlots ? vPP : na, "vPP", color.new(color.green, 30), 2)
plot(showPlots ? vPU : na, "vPU", color.new(color.aqua, 30), 1)
plot(showPlots ? vPA : na, "vPA", color.new(color.red, 30), 1)

plot(showPlots ? vPP2 : na, "vPP2", color.new(color.green, 50), 2)
plot(showPlots ? vPU2 : na, "vPU2", color.new(color.aqua, 50), 1)
plot(showPlots ? vPA2 : na, "vPA2", color.new(color.red, 50), 1)

plotshape(noPos and longEntry, title="BUY", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.tiny)
plotshape(noPos and shortEntry, title="SELL", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.tiny)
plotshape(inLong and shortEntry, title="SELL", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.tiny)
plotshape(inShort and longEntry, title="BUY", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.tiny)

// ============================================================
// PANEL
// ============================================================

var table info = table.new(position.bottom_right, 2, 4, bgcolor=color.black)

if barstate.islast
    table.cell(info, 0, 0, "vPP:", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, str.tostring(vPP, format.mintick), text_color=color.lime, text_size=size.small)
    table.cell(info, 0, 1, "vPU:", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 1, str.tostring(vPU, format.mintick), text_color=color.orange, text_size=size.small)
    table.cell(info, 0, 2, "vPA:", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 2, str.tostring(vPA, format.mintick), text_color=color.orange, text_size=size.small)
    table.cell(info, 0, 3, "WillR:", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 3, str.tostring(wpr, format.mintick), text_color=color.orange, text_size=size.small)
