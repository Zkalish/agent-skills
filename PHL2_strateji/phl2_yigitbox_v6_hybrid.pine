//@version=6
// ============================================================
// PHL2 YIGITBOX - Günlük + HighestSince
// ============================================================

strategy(
     "PHL2 YIGITBOX",
     overlay     = true,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     commission_type = strategy.commission.percent,
     commission_value = 0,
     slippage = 1
)

// ============================================================
// GIRDILER
// ============================================================

wprLength = input.int(3, title="Williams %R", minval=2)
longWpr = input.float(-20, title="LONG WillR")
shortWpr = input.float(-70, title="SHORT WillR")
showPlots = input.bool(true, title="Göster")

// ============================================================
// FONKSIYONLAR
// ============================================================

GetHighestSince(cond, src) =>
    var float val = na
    if cond or src > val
        val := src
    val

GetLowestSince(cond, src) =>
    var float val = na
    if cond or src < val
        val := src
    val

// ============================================================
// GÜNLÜK VERİ + GÜN İÇİ
// ============================================================

// Günlük veri
[dHigh, dLow, dClose, dTime] = request.security(
     syminfo.tickerid, "D",
     [high, low, close, time],
     lookahead = barmerge.lookahead_on
)

isNewDay = ta.change(dTime) != 0

// ============================================================
// DEĞERLER
// ============================================================

// Gün değişiminde değerler
var float ADAM = na
var float TX_val = na
var float RX_val = na

if isNewDay
    // ADAM: Önceki günün kapanışı
    ADAM := dClose[1]

    // TX: Önceki günün high'ı VEYA gün içi en yüksek
    TX_val := math.max(dHigh[1], high)

    // RX: Önceki günün low'u VEYA gün içi en düşük
    RX_val := math.min(dLow[1], low)
else
    // Gün içinde güncellenmeye devam
    TX_val := math.max(TX_val, high)
    RX_val := math.min(RX_val, low)

// Pivot
PVT1 = (ADAM + RX_val + TX_val) / 3
PVT2 = ADAM

// Seviyeler
r1 = 2 * PVT1 - RX_val
s1 = 2 * PVT1 - TX_val
r2 = PVT2 + (TX_val - RX_val) / 2
s2 = PVT2 - (TX_val - RX_val) / 2

sma1 = ta.sma(close, 1)
wpr = ta.wpr(wprLength)

// ============================================================
// SİNYALLER
// ============================================================

longCond = (sma1 > PVT2) and (sma1 > PVT1) and (wpr > longWpr)
shortCond = (sma1 < PVT2) and (sma1 < PVT1) and (wpr < shortWpr)

longEntry = longCond and not longCond[1]
shortEntry = shortCond and not shortCond[1]

inLong = strategy.position_size > 0
inShort = strategy.position_size < 0
noPos = strategy.position_size == 0

// ============================================================
// İŞLEMLER
// ============================================================

if noPos and longEntry
    strategy.entry("Long", strategy.long)

if noPos and shortEntry
    strategy.entry("Short", strategy.short)

if inLong and shortEntry
    strategy.close("Long")
    strategy.entry("Short", strategy.short)

if inShort and longEntry
    strategy.close("Short")
    strategy.entry("Long", strategy.long)

// ============================================================
// GÖRSEL
// ============================================================

plot(showPlots ? PVT1 : na, "PVT1", color.blue, 2)
plot(showPlots ? r1 : na, "R1", color.green, 1)
plot(showPlots ? s1 : na, "S1", color.red, 1)
plot(showPlots ? PVT2 : na, "PVT2", color.orange, 2)

plotshape(noPos and longEntry, title="BUY", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.tiny)
plotshape(noPos and shortEntry, title="SELL", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.tiny)
plotshape(inLong and shortEntry, title="SELL", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.tiny)
plotshape(inShort and longEntry, title="BUY", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.tiny)

// Panel
var table info = table.new(position.bottom_right, 2, 4, bgcolor=color.black)

if barstate.islast
    table.cell(info, 0, 0, "ADAM:", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, str.tostring(ADAM, format.mintick), text_color=color.lime, text_size=size.small)
    table.cell(info, 0, 1, "TX:", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 1, str.tostring(TX_val, format.mintick), text_color=color.orange, text_size=size.small)
    table.cell(info, 0, 2, "RX:", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 2, str.tostring(RX_val, format.mintick), text_color=color.orange, text_size=size.small)
    table.cell(info, 0, 3, "PVT1:", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 3, str.tostring(PVT1, format.mintick), text_color=color.orange, text_size=size.small)
